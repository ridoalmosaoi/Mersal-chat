const socket = io();

let adminLogged = false;

/* LOGIN */

function loginAdmin(){

const name =

document
.getElementById(
"adminName"
)
.value
.trim();

const password =

document
.getElementById(
"adminPassword"
)
.value
.trim();

if(!name || !password){

alert(
"املأ المعلومات"
);

return;

}

socket.emit(

"admin panel login",

{

name:name,

password:password

}

);

}

/* LOGIN SUCCESS */

socket.on(

"admin login success",

()=>{

adminLogged = true;

document
.getElementById(
"adminLogin"
)
.style.display =
"none";

document
.getElementById(
"adminPanel"
)
.style.display =
"block";

addLog(
"✅ تم تسجيل الدخول"
);

});

/* LOGIN FAILED */

socket.on(

"admin login failed",

()=>{

alert(
"اسم أو كلمة السر خطأ 🚫"
);

});

/* CONNECT */

socket.on(

"connect",

()=>{

console.log(
"Admin Connected ✅"
);

});

/* ONLINE USERS */

socket.on(

"admin online users",

(users)=>{

const box =

document.getElementById(
"onlineUsers"
);

if(!box){
return;
}

box.innerHTML = "";

if(users.length <= 0){

box.innerHTML = `

<div class="user-card">

لا يوجد متصلين

</div>

`;

return;

}

users.forEach(user=>{

const div =

document.createElement(
"div"
);

div.className =
"user-card";

div.innerHTML = `

👤 ${user.username}

<br>

🌐 ${user.ip}

<br>

💻 ${user.device || "Unknown"}

<br><br>

<button onclick="
kickUser('${user.id}')
">

⚠️ طرد

</button>

<button onclick="
banUser('${user.id}')
">

🚫 حظر

</button>

<button onclick="
disconnectUser('${user.id}')
">

⛔ فصل كلي

</button>

`;

box.appendChild(
div
);

});

});

/* BANNED USERS */

socket.on(

"admin banned users",

(list)=>{

const box =

document.getElementById(
"bannedUsers"
);

if(!box){
return;
}

box.innerHTML = "";

if(list.length <= 0){

box.innerHTML = `

<div class="user-card">

لا يوجد محظورين

</div>

`;

return;

}

list.forEach((ban,index)=>{

const div =

document.createElement(
"div"
);

div.className =
"user-card";

const time =

ban.time

?

new Date(
ban.time
).toLocaleString()

:

"غير معروف";

div.innerHTML = `

👤 ${ban.username}

<br>

🌐 ${ban.ip}

<br>

🕒 ${time}

<br>

🚫 ${

ban.fullDisconnect

?

"فصل كلي"

:

"حظر"

}

<br><br>

<button onclick="
unbanUser(${index})
">

✅ فك الحظر

</button>

`;

box.appendChild(
div
);

});

});

/* ADMINS */

socket.on(

"admins list",

(admins)=>{

renderAdmins(
admins
);

});

function renderAdmins(admins){

const box =

document.getElementById(
"adminsList"
);

if(!box){
return;
}

box.innerHTML = "";

admins.forEach((admin,index)=>{

const div =

document.createElement(
"div"
);

div.className =
"user-card";

div.innerHTML = `

👮 ${admin.name}

<br><br>

<button onclick="
removeAdmin(${index})
">

❌ حذف الأدمن

</button>

`;

box.appendChild(
div
);

});

}

/* ADD ADMIN */

function addAdmin(){

const name =

document
.getElementById(
"newAdminName"
)
.value
.trim();

const password =

document
.getElementById(
"newAdminPassword"
)
.value
.trim();

if(!name || !password){

alert(
"املأ المعلومات"
);

return;

}

socket.emit(

"add admin",

{

name:name,

password:password

}

);

document
.getElementById(
"newAdminName"
)
.value = "";

document
.getElementById(
"newAdminPassword"
)
.value = "";

addLog(
`👮 تمت إضافة أدمن ${name}`
);

}

/* REMOVE ADMIN */

function removeAdmin(index){

socket.emit(
"remove admin",
index
);

addLog(
"❌ تم حذف أدمن"
);

}

/* ACTIONS */

function kickUser(id){

socket.emit(
"kick user",
id
);

addLog(
"⚠️ تم طرد مستخدم"
);

}

function banUser(id){

socket.emit(
"ban user",
id
);

addLog(
"🚫 تم حظر مستخدم"
);

}

function disconnectUser(id){

socket.emit(
"disconnect user",
id
);

addLog(
"⛔ تم فصل مستخدم كليًا"
);

}

function unbanUser(index){

socket.emit(
"unban user",
index
);

addLog(
"✅ تم فك الحظر"
);

}

/* SETTINGS */

function toggleChatLock(){

socket.emit(
"toggle chat lock"
);

addLog(
"🔒 تم تغيير حالة العام"
);

}

function togglePrivateLock(){

socket.emit(
"toggle private lock"
);

addLog(
"💬 تم تغيير حالة الخاص"
);

}

function clearChat(){

socket.emit(
"clear chat"
);

addLog(
"🧹 تم تنظيف الشات"
);

}

function maintenanceMode(){

socket.emit(
"maintenance mode"
);

addLog(
"🛠️ تم تشغيل وضع الصيانة"
);

}

/* SERVER INFO */

socket.on(

"server stats",

(stats)=>{

const box =

document.getElementById(
"serverInfo"
);

if(!box){
return;
}

box.innerHTML = `

🟢 السيرفر يعمل

<br><br>

👥 المتصلين:
${stats.onlineUsers}

<br><br>

🚫 المحظورين:
${stats.bannedUsers}

<br><br>

👮 الأدمنية:
${stats.admins}

`;

});

/* LOGS */

function addLog(text){

const logsBox =

document.getElementById(
"logsBox"
);

if(!logsBox){
return;
}

const div =

document.createElement(
"div"
);

div.className =
"user-card";

div.innerHTML = `

${text}

<br><br>

🕒 ${new Date().toLocaleTimeString()}

`;

logsBox.prepend(
div
);

}
